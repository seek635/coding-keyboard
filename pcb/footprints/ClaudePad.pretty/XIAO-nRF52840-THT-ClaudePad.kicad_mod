(footprint "XIAO-nRF52840-THT-ClaudePad" (layer F.Cu) (tedit 0)
  (descr "Seeed XIAO nRF52840, 2x7 2.54mm through-hole headers, USB-C at -Y")
  (tags "XIAO nRF52840 THT 2.54mm header")
  (attr through_hole)

  (fp_line (start -8.945 -10.55) (end 8.855 -10.55) (layer F.Fab) (width 0.1))
  (fp_line (start 8.855 -10.55) (end 8.855 10.4) (layer F.Fab) (width 0.1))
  (fp_line (start 8.855 10.4) (end -8.945 10.4) (layer F.Fab) (width 0.1))
  (fp_line (start -8.945 10.4) (end -8.945 -10.55) (layer F.Fab) (width 0.1))

  (pad "1" thru_hole rect (at -7.62 -7.62) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (pad "2" thru_hole circle (at -7.62 -5.08) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (pad "3" thru_hole circle (at -7.62 -2.54) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (pad "4" thru_hole circle (at -7.62 0) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (pad "5" thru_hole circle (at -7.62 2.54) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (pad "6" thru_hole circle (at -7.62 5.08) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (pad "7" thru_hole circle (at -7.62 7.62) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (pad "8" thru_hole circle (at 7.62 7.62) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (pad "9" thru_hole circle (at 7.62 5.08) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (pad "10" thru_hole circle (at 7.62 2.54) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (pad "11" thru_hole circle (at 7.62 0) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (pad "12" thru_hole circle (at 7.62 -2.54) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (pad "13" thru_hole circle (at 7.62 -5.08) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (pad "14" thru_hole circle (at 7.62 -7.62) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
)
