(module JST_PH_2.00mm_THT (layer F.Cu) (tedit 0)
  (descr "JST PH 2.0mm 2-pin through-hole battery connector")
  (tags "JST PH 2.0 battery")
  
  
  
  
  
  
  
  
  
  (pad 1 thru_hole rect (at 0 0) (size 1.8 1.8) (drill 0.9) (layers *.Cu *.Mask))
  (pad 2 thru_hole rect (at 2.0 0) (size 1.8 1.8) (drill 0.9) (layers *.Cu *.Mask))
)
