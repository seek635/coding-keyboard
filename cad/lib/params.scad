// =============================================================================
// ClaudePad · 全局参数表 (params.scad)
// -----------------------------------------------------------------------------
// 单位：毫米 (mm)
//
// ★ 核心原则：垂直方向的尺寸「不写死」，全部由零件堆叠推导。
//   这样任何一个零件的实际尺寸变了，整机高度会自动跟着变，不会出现
//   "定位板抬高 4mm 导致轴体够不到 PCB" 这类致命错误。
//
// ★ 打印公差按 FDM 0.4mm 喷嘴 / PLA 或 PETG 设定。
// =============================================================================

// ---------- 1. 键位网格（依据 PRD 3.1.1 三行五列）----------------------------
COLS = 5;                       // 列数
ROWS = 3;                       // 行数
PITCH = 18.0;                   // 键位中心距（Choc 推荐 18.0）

// 网格尺寸 = 列数 × 间距（纯宽度，不含任何原点偏移）
GRID_W = COLS * PITCH;          // = 90.0
GRID_H = ROWS * PITCH;          // = 54.0

// 键位定义表：[列(1起), 行(1起), 宽度格数(u), 类型标签]
KEYMAP = [
    // ---- 行 1 ----
    [1,1, 1, "PERM"],           // 访问等级
    [2,1, 1, "UP"],             // ↑
    [3,1, 1, "MODEL"],          // 模型
    [4,1, 1, "CMD"],            // 命令行
    [5,1, 1, "STOP"],           // 停止
    // ---- 行 2 ----
    [1,2, 1, "LEFT"],           // ←
    [2,2, 1, "DOWN"],           // ↓
    [3,2, 1, "RIGHT"],          // →
    [4,2, 2, "ENTER"],          // 回车（跨列 4-5）
    // ---- 行 3 ----
    [1,3, 4, "SPACE"],          // 空格（跨列 1-4）
    [5,3, 1, "VOICE"],          // 语音
];

// ---------- 2. 轴体（凯华 Choc **V2** 矮轴 / PG1353）-------------------------
// ★ 2026-09-16：确认使用 Choc **V2**，与 V1（PG1350）的关键差异 ——
//   · 轴心：V1 是 3.4mm 矩形十字，V2 换成 **5mm MX 十字** → 键帽榫槽必须改（V1 键帽装不上）
//   · 键程：V1 3.0mm，V2 **3.2±0.25mm** → SWITCH_TRAVEL 改 3.2
//   · PCB 中心孔：V1 3.0mm，V2 **5.0mm**
//   · 固定脚：V2 **取消 fixing pins**（原 (±5.5,0) 侧孔对 V2 无用，保留不影响装配）
//   · 电气引脚位置：与 V1 **相同** → PCB 焊盘不用改
//   · 总高：比 V1 略增，具体值待实测
// 【来源】themk.org PG1353 词条 + mwlabs.be 实装日志（两处独立印证）
SWITCH_CUTOUT = 13.80;          // 定位板开孔边长（V2 与 V1 相同，仍待实物确认）
SWITCH_CUTOUT_TOL = 0.10;       // 3D 打印补偿（见 §10 公差总表）
SWITCH_CLIP_W = 2.60;           // 侧卡扣槽宽度
SWITCH_CLIP_H = 1.90;           // 侧卡扣槽深度
SWITCH_TOP_ABOVE_PCB = 8.00;    // 轴体总高：PCB 上表面 → 轴芯顶面（未按压）[spec，V2 略增待实测]
// ★ 轴体键程（按下深度）。这个值决定键帽必须离定位板多远，见 §13。
SWITCH_TRAVEL = 3.20;           // Choc V2 官方 3.2±0.25（V1 是 3.0）

// ---------- 3. 定位板（Plate）-----------------------------------------------
// ★ Choc 定位板标准厚度是 1.2mm（比 MX 的 1.5mm 薄），这是轴体卡扣的设计值。
//   3D 打印若 1.2mm 太软，最多加到 1.5mm，不要用 1.6。
PLATE_T = 1.20;
PLATE_BORDER = 6.00;            // 网格外缘到定位板边缘（需容纳螺丝柱，见 §11）

// 定位板外形（由网格 + 边距推导）
PLATE_W = GRID_W + PLATE_BORDER * 2;    // = 90 + 12 = 102.0
PLATE_H = GRID_H + PLATE_BORDER * 2;    // = 54 + 12 = 66.0

// PCB 上表面 → 定位板底面（= 轴体卡扣唇的高度）
//
// ★ 这个参数同时决定两件事，必须一起满足：
//   ① 轴体卡扣必须正好落在这里（偏大 → 轴体悬空按不动；偏小 → 卡扣咬不上）
//   ② 主控要放在 PCB 上方，所以它必须 ≥ NANO_H + 余量（≈ 3.7mm）
//
// 【唯一需要实物确认的参数】Choc 官方图纸未公开此值，社区实测在 3.5~6.0 之间。
//   当前取 5.0：既满足主控净空，也与常见 Choc 定位板垫高实践一致。
//   ⚠️ 打印前先打 cad/test_coupon.scad 实测，再回填这里。
SWITCH_PLATE_GAP = 5.00;

// 定位板上表面 → 轴芯顶面（由上面几个值推导，不要单独改）
SWITCH_TIP_ABOVE_PLATE = SWITCH_TOP_ABOVE_PCB - SWITCH_PLATE_GAP - PLATE_T;

// ---------- 4. PCB ----------------------------------------------------------
PCB_T = 1.60;                   // PCB 厚度（1.6 标准）

// PCB 下表面 → 底板上表面（电池与走线层）
// 需容纳：电池（4.0）+ 双面胶（0.6）+ 排线余量
PCB_STANDOFF_H = 5.00;

// PCB 外形（四角要让开螺丝柱，右侧要让开拨杆本体）
// ★ 2026-09-16：PCB 加宽 86 → 98，解决「USB 口够不到外壳右壁」
//   原 86mm 时 USB 口距内腔右壁 8.2mm，而 USB-C 插头金属部分只有 6.5mm → 插不到底。
//   加宽后 PCB 右缘距内腔右壁 2.15mm，插入深度 4.55mm < 6.5 ✓
//   （PCB 在 y 方向天然避开四角螺丝柱：PCB 占 y 8~58，螺丝柱占 y 1.5~6.5 与 59.5~64.5）
PCB_W = 98.00;                  // 原 86（GRID_W − 4）
PCB_H = GRID_H - 4.00;          // = 50.0（不变）
PCB_X = (PLATE_W - PCB_W) / 2;  // = 2.0
PCB_Y = (PLATE_H - PCB_H) / 2;  // = 8.0

// ---- PCB 支撑台 ----------------------------------------------------------
// ★ 关键约束：支撑台不能放在 PCB 四角 —— 那里正好是轴体的塑料脚位置，
//   顶住就装不进去。轴体之间只有 PITCH − 轴体宽 = 18 − 13.5 = 4.5mm 空隙，
//   所以支撑台必须放在「空隙中央」，且直径要小于 4.5。
PCB_SUPPORT_D = 4.00;           // 支撑台直径（必须 < 4.5）
// 支撑台位置（PCB 坐标系）—— 取两个行间隙 × 两个列间隙的交叉点
// 列间隙中心（PCB 坐标，PCB_X = 2）= 22 / 40 / 58 / 76
// ★ 2026-09-16 改：PCB 加宽后 PCB_X 从 8 变 2，所有间隙中心整体左移 6mm。
//   x=22 被电池占（电池贴左壁，PCB 坐标 −2~28）；x=58 距主控（80 起）偏远且不对称。
//   取 40 / 76 —— 间距 36mm，对称，且与电池、主控都留有余量。
PCB_SUPPORT_X1 = 40.00;         // 列2/列3 之间的空隙中心
PCB_SUPPORT_X2 = 76.00;         // 列4/列5 之间的空隙中心
PCB_SUPPORT_Y1 = 16.00;         // 行1/行2 之间的空隙中心
PCB_SUPPORT_Y2 = 34.00;         // 行2/行3 之间的空隙中心

// ⚠️ PCB 右侧需开缺口让位给拨杆本体（这是 PCB 设计规格，不参与外壳建模）
//    缺口：从 PCB 右缘向内 8mm，纵向 24mm，位置对准拨杆
PCB_NOTCH_D = 8.00;             // 缺口深度 [spec]
PCB_NOTCH_L = 24.00;            // 缺口长度 [spec]

// ---------- 5. 底座（Case）--------------------------------------------------
CASE_WALL = 2.40;               // 侧壁厚度
CASE_BOTTOM_T = 2.00;           // 底板厚度
CASE_RADIUS = 3.00;             // 四角圆角半径
CASE_TOP_TOL = 0.15;            // 定位板与内腔的配合公差（单边）

// ★ 内腔高度由堆叠推导（不要再写死数值！）
//   = PCB 支撑台 + PCB + 轴体卡扣间隙
CASE_INNER_H = PCB_STANDOFF_H + PCB_T + SWITCH_PLATE_GAP;   // = 10.10

// 底座总高 = 底板 + 内腔 + 定位板（定位板顶面与外壳上沿齐平）
CASE_OUTER_H = CASE_BOTTOM_T + CASE_INNER_H + PLATE_T;      // = 13.30

// ---------- 6. 主控 nice!nano v2（兼容板）------------------------------------
// ★ 2026-09-16：用户实际购买的是 **nice!nano v2.0_SMT**（大熊智能 / 深圳蓝牙dx）
//   说明书原文：「ProMicro 替代开发板，兼容 Nice!Nano，引脚与 Nice!Nano 相同，
//   在此基础上新增了 SMT 半孔焊盘，直插和贴片都兼容」
//   → 引脚定义与官方一致，本项目不用改；通孔焊盘仍在，新手可走通孔
//   ⚠️ 尺寸比官方略大：官方 17.8 × 33.0，实测标注 18.0 × 34.1
//   ⚠️ 电池容量必须 ≥ 400mAh（见下方充电电流说明）
NANO_W = 18.00;                 // 板宽（官方 17.80，兼容板 18.00）
NANO_L = 34.10;                 // 板长（官方 33.00，兼容板 34.10）
NANO_H = 3.20;                  // 板 + 元件高度（与卖家标注的 3.2mm 一致）
NANO_USB_W = 9.00;              // USB-C 开孔宽
NANO_USB_H = 3.60;              // USB-C 开孔高
NANO_USB_TOL = 0.40;            // USB 开孔公差（宁大勿小）
// ★ 充电电流约束（来自该板说明书）：
//   默认 BOOST=NC → 充电电流 185mA，厂方警告「充电电流必须 ≤ 电池容量的一半」，
//   否则电池寿命加速衰减甚至爆炸。→ 电池容量必须 ≥ 370mAh，取 **400mAh 以上**。
//   （BOOST 焊 10K = 250mA 需 ≥500mAh；焊 0R = 300mA 需 ≥600mAh，都是往大调，不解决问题）

// ★ 安装面与位置（2026-09-16 方案 A：主控移到 PCB 背面）
//   原因：PCB 正面被 14 个轴体占满，穷举板面所有位置后「零重叠位置数 = 0」
//   可行性：PCB 下方层高 PCB_STANDOFF_H = 5.0 > 主控厚 3.2，余 1.80mm
//   朝向：USB-C 朝右壁；背面右侧无电池（电池已让位到左侧）
//   ✅ USB 可达性已解决：PCB 加宽到 98 后，USB 口距内腔右壁 2.15mm，
//      插入深度 4.55mm < 插头金属部分 6.5mm（见 PCB设计规格书 §14.6）
NANO_ON_BACK = true;            // true = 装在 PCB 下表面
NANO_POS_X = 79.50;             // 主控左下角，PCB 坐标系（右缘 97.5，板缘 98，留 0.5）
NANO_POS_Y = 8.50;              // 主控左下角，PCB 坐标系

// ---------- 7. 电池 ---------------------------------------------------------
// 【注意】PCB_STANDOFF_H = 5.0 时，电池可用厚度 = 5.0 − 0.6(胶) = 4.4mm
BATT_W = 30.00;                 // 电池宽（500mAh 软包典型值）
BATT_L = 40.00;                 // 电池长
BATT_H = 4.00;                  // 电池厚度（薄型软包）
BATT_TOL = 1.00;                // 电池仓单边余量
BATT_TAPE_T = 0.60;             // 双面泡棉胶厚度

// ---------- 8. 侧边审批拨杆（SPDT 拨动开关）--------------------------------
// 安装方式：拨杆 + 轴套 + 螺母在【壳外】，开关本体在【壳内】。
//           所以壳壁上只需要一个轴套过孔，不需要拨杆行程槽。
// ⚠️ 不同型号差异可达 2mm，买回来务必量：轴套直径 / 轴套长度 / 面板尺寸
SW_W = 7.00;                    // 开关面板宽度 [spec]
SW_L = 13.00;                   // 开关面板长度 [spec]
SW_BUSH_D = 6.00;               // 螺纹轴套直径
SW_BUSH_H = 9.00;               // 螺纹轴套长度（要穿过 壁 + 凸台 + 螺母）
SW_NUT_T = 2.00;                // 螺母厚度（在壳外，占轴套长度）
SW_BODY_D = 8.50;               // 开关本体沿轴套方向的厚度 [spec]（决定 PCB 缺口深度）
SW_LEVER_L = 8.00;              // 拨杆长度 [spec]（在壳外，不干涉壳体）
SW_BOSS_D = 12.00;              // 凸台直径（圆形凸台，需小于外壳高度）

// ★ 凸台厚度由轴套长度推导：
//   约束：CASE_WALL + SW_BOSS_T + SW_NUT_T ≤ SW_BUSH_H − 0.5（留 0.5 余量）
SW_BOSS_T = max(2.0, SW_BUSH_H - CASE_WALL - SW_NUT_T - 0.50);   // = 4.10

// ---------- 9. 走线通道 -----------------------------------------------------
WIRE_CH_W = 3.00;               // 走线槽宽
WIRE_CH_D = 2.00;               // 走线槽深（从底板上表面下挖）
WIRE_MAX_D = 2.20;              // 可通过的最大线径 [spec]

// ---------- 10. 3D 打印公差总表（FDM 0.4mm 喷嘴）---------------------------
TOL_HOLE = 0.20;                // 紧固孔单边放大
TOL_SLOT = 0.20;                // 卡槽 / 长孔宽度放大 [spec]
TOL_BOTTOM_CHAMFER = 0.20;      // 首层大象脚补偿（底部 0.2×45° 倒角）

// ★ CSG 融合重叠量：所有「贴附在母体表面」的凸起（螺丝柱 / 支撑台 /
//   挡墙 / 凸台）都要往母体里多伸 0.5mm。否则两个实体的面完全共面，
//   并集后会产生非流形边（STL 不水密），切片软件可能报错。
FUSE_OVERLAP = 0.50;

// ---------- 11. 螺丝与固定柱 -----------------------------------------------
// ★ 关键约束：轴孔之间只有 PITCH − 轴孔 = 18 − 13.9 = 4.1mm 净距，
//   所以螺丝柱只能放在「网格外缘到定位板边缘」的边距里，不能放进网格。
SCREW_M2_TAP = 1.70;            // M2 自攻螺丝底孔（PLA）
SCREW_M2_CLEAR = 2.30;          // M2 通孔
POST_D = 5.00;                  // 螺丝柱外径
SCREW_INSET = 4.00;             // 螺丝中心距定位板边缘
// 校验：柱外缘 = 4.0 + 2.5 = 6.5；轴孔近边 = PLATE_BORDER + PITCH/2 − 13.9/2
//       = 6.0 + 9.0 − 6.95 = 8.05  →  余量 1.55mm ✓

// ---------- 12. 脚垫与底部开孔 ---------------------------------------------
FOOT_D = 8.00;                  // 脚垫直径
FOOT_DEPTH = 1.00;              // 脚垫沉孔深度
FOOT_INSET = 9.00;              // 脚垫距底座边缘
BOTTOM_VENT_D = 4.00;           // 通气孔直径
VENT_COLS = 3;                  // 通气孔阵列列数
VENT_ROWS = 2;                  // 通气孔阵列行数（共 6 个孔）

// ---------- 13. 键帽参数 ---------------------------------------------------
// ★★ 键帽必须能按下整个键程，否则按键根本按不动 ★★
//
//   键帽裙边（17.6mm）比定位板轴孔（13.8mm）宽，**塞不进孔里**。
//   所以键帽下压时，裙边会直接撞在定位板顶面上。
//   → 键帽底面到定位板顶面的距离必须 ≥ 轴体键程。
//
//   约束 1（行程）：CAP_GAP ≥ SWITCH_TRAVEL
//   约束 2（榫槽够深）：CAP_GAP + CAP_STEM_DEPTH ≥ SWITCH_ABOVE_PLATE
CAP_GAP_MARGIN = 0.30;          // 行程余量（让轴体自己到底，而不是裙边撞板到底）
CAP_GAP = SWITCH_TRAVEL + CAP_GAP_MARGIN;   // = 3.30（由键程推导，不要写死）

CAP_H = 5.00;                   // 键帽高度（Choc 矮键帽典型值）
CAP_TOP_R = 3.00;               // 键帽顶面圆角
CAP_WALL = 1.80;                // 键帽壁厚
CAP_TOP_T = 1.60;               // 键帽顶面厚度
CAP_TAPER = 0.55;               // 顶面收窄（上小下大的斜度）
CAP_STEM_DEPTH = 3.60;          // 十字榫槽深度
CAP_STEM_BOSS_D = 6.00;         // 榫头柱直径（MX 键帽典型 5.5–6.5）
// ★ 2026-09-16：轴体改用 Choc V2（MX 十字轴心），榫槽尺寸与 V1 的小十字完全不同
//   V1 小十字：臂长 1.20、臂宽 0.95
//   V2 MX 十字：臂长 4.0、臂宽 ~1.2 → 槽按 MX 标准并留松配
//   ⚠️ V1 键帽装不上 V2 轴体，反之亦然 —— 已打印的 V1 键帽需按新参数重打
CAP_CROSS_L = 4.00;             // 十字臂长（MX 标准）
CAP_CROSS_W = 1.30;             // 十字臂宽（MX 筋厚 ~1.2 + 0.1 松配）
CAP_RIB_T = 1.20;               // 内部加强筋厚度
CAP_RIB_COUNT_LONG = 3;         // 4u 键帽加强筋数量
CAP_RIB_COUNT_MED = 1;          // 2u 键帽加强筋数量

// ---------- 14. 装配间隙总则（设计规则，不参与建模）------------------------
GAP_COMPONENT = 0.50;           // 元器件之间最小间隙 [spec]
GAP_HEAT = 1.50;                // 发热件周围最小净空 [spec]

// ---------- 15. 整机总高（放在最后，因为它依赖前面所有零件尺寸）-----------
// 桌面 → 键帽顶面
TOTAL_H = CASE_OUTER_H + CAP_GAP + CAP_H;

// ---------- 16. 曲面细分 ---------------------------------------------------
$fn = 64;

