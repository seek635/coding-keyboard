/*
 * ClaudePad — ZMK 键位映射
 * ---------------------------------------------------------------------------
 * 键位序号必须与 claudepad.overlay 里 default_transform 的 map 顺序一致。
 *
 *   0  访问等级   1  ↑      2  模型     3  命令行   4  停止    5  审批拨杆
 *   6  ←         7  ↓      8  →        9  回车
 *   10 空格      11 语音
 *
 * 本文件实现了 PRD 第 3 章定义的全部单击 / 双击 / 长按手势。
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    /*
     * ======================= 宏（发送字符串 / 组合键）=======================
     * 宏里 send 序列需要 ≥30ms 的间隔，否则 BLE HID 通知可能被合并后乱序。
     * 但单击类宏（只发一个键）用 5ms 就够，避免手感迟滞。
     */
    macros {
        /* 输入 "/voice" 并回车 —— 切换语音功能启用状态 */
        m_slash_voice: m_slash_voice {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms  = <30>;
            bindings = <&kp SLASH &kp V &kp O &kp I &kp C &kp E &kp ENTER>;
        };

        /* 输入 "/model" 并回车 —— 唤起模型选择列表 */
        m_slash_model: m_slash_model {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms  = <30>;
            bindings = <&kp SLASH &kp M &kp O &kp D &kp E &kp L &kp ENTER>;
        };

        /* 输入 "@" —— 文件引用（命令行键长按）*/
        m_at: m_at {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms  = <5>;
            bindings = <&kp AT>;
        };

        /* 输入一次 Tab —— 自动补全（空格键长按）
           用宏而不是直接 &kp TAB，是为了避免长按时连续触发多次 Tab */
        m_tab: m_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms  = <5>;
            bindings = <&kp TAB>;
        };

        /* Ctrl+C 连按两次 —— 退出会话（停止键长按）
           间隔 250ms 给终端留出处理时间 */
        m_quit: m_quit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <250>;
            tap-ms  = <30>;
            bindings = <&kp LC(C) &kp LC(C)>;
        };

        /*
         * 下面两个宏是「发给上位机软件的信号」，不产生可见字符。
         * 用 Ctrl+Alt+Shift+F13/F14 这种极难误触的组合，
         * 上位机监听这两个键即可执行对应操作（见 docs/固件设计说明.md）。
         */
        m_perm_reset: m_perm_reset {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms  = <5>;
            bindings = <&kp LC(LA(LS(F13)))>;
        };

        m_model_cycle: m_model_cycle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms  = <5>;
            bindings = <&kp LC(LA(LS(F14)))>;
        };
    };

    /*
     * ============================ 自定义行为 ==============================
     */
    behaviors {
        /*
         * 停止键的「单击 / 双击」部分
         *   1 次 → Esc      中断当前生成，保留上下文
         *   2 次 → Ctrl+C   强制取消任务
         */
        stop_td: stop_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp ESC>, <&kp LC(C)>;
        };

        /*
         * 停止键（总入口）
         *   单击   → stop_td（Esc）
         *   双击   → stop_td（Ctrl+C）
         *   长按   → m_quit（Ctrl+C ×2，退出会话）
         *
         * tapping-term 设 1200ms：退出会话是破坏性操作，必须刻意长按才触发。
         * flavor = tap-preferred：快速点按时优先判为 tap，避免误退。
         */
        stop: stop_key {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <1200>;
            bindings = <&m_quit>, <&stop_td>;
            display-name = "Stop";
        };

        /*
         * 语音键的「双击」部分
         *   1 次 → 无操作（单击的语义是"按住"，由外层 hold-tap 处理）
         *   2 次 → /voice 切换启用状态
         */
        voice_td: voice_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&none>, <&m_slash_voice>;
        };

        /*
         * 语音键（总入口）
         *   按住   → Space（push-to-talk，配合已启用的 /voice）
         *   单击   → 无操作
         *   双击   → /voice
         *
         * 用 hold-preferred：只要按住超过 200ms 就进 push-to-talk，
         * 这符合"按住说话"的直觉。
         */
        voice: voice_key {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&voice_td>;
            display-name = "Voice";
        };

        /*
         * 回车键
         *   单击 → Enter（发送）
         *   双击 → Shift+Enter（输入框内换行）
         */
        ent_td: enter_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp ENTER>, <&kp LS(ENTER)>;
        };

        /*
         * 访问等级键
         *   单击 → Shift+Tab（循环切换权限档位，Claude Code 原生行为）
         *   长按 → m_perm_reset（发信号给上位机，一键复位到 default）
         *
         * ⚠️ 长按不能由键盘自己完成复位：键盘无法知道当前处于哪一档
         *    （可能是用户在别处按了 Shift+Tab，或 Claude Code 自己切换）。
         *    所以这里只发信号，由读取状态栏的上位机执行真正的复位。
         */
        perm: perm_key {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <400>;
            quick-tap-ms = <200>;
            bindings = <&m_perm_reset>, <&kp>;
            display-name = "Permission";
        };

        /*
         * 模型键
         *   单击 → /model + Enter（唤起选择器）
         *   长按 → m_model_cycle（发信号给上位机，循环切换常用模型）
         *
         * 长按不发按键而是发信号，是因为"在 Opus / Sonnet 之间循环"
         * 需要知道当前是哪个模型 —— 同样只有上位机知道。
         */
        model: model_key {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <400>;
            quick-tap-ms = <200>;
            bindings = <&m_model_cycle>, <&m_slash_model>;
            display-name = "Model";
        };

        /*
         * 命令行键
         *   单击 → "/"（唤起斜杠命令补全菜单）
         *   长按 → "@"（文件引用）
         *
         * 长按侧用宏（m_at）而不是 &kp AT，避免长按时连续输出 @@@@@@
         */
        cmd: cmd_key {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            bindings = <&m_at>, <&kp>;
            display-name = "Command";
        };

        /*
         * 空格键
         *   单击 → Space
         *   长按 → Tab（自动补全）
         *
         * tapping-term 设 300ms 且用 tap-preferred：
         * 空格是最高频键，必须确保正常打字不会被误判成长按。
         * 只有刻意按住 300ms 才出 Tab。
         */
        spc_tab: space_tab {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <120>;
            bindings = <&m_tab>, <&kp>;
            display-name = "Space/Tab";
        };
    };

    /*
     * ============================== 键位映射 ==============================
     * bindings 顺序必须与 overlay 里 default_transform 的 map 一致。
     *
     * hold-tap 的用法：&行为 <hold 参数> <tap 参数>
     * 零参数行为（宏 / tap-dance）用 0 占位。
     */
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "ClaudePad";
            bindings = <
            /* 行1 */  &perm 0 LS(TAB)   &kp UP      &model 0 0    &cmd 0 SLASH   &stop 0 0    &kp F13
            /* 行2 */  &kp LEFT          &kp DOWN    &kp RIGHT     &ent_td
            /* 行3 */  &spc_tab 0 SPACE  &voice SPACE 0
            >;
        };
    };
};
