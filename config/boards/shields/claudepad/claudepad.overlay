/*
 * ClaudePad shield
 *
 * Seeed XIAO nRF52840 (ZMK board: xiao_ble//zmk), hand-wired.
 *
 * 3 rows x 5 columns, 11 used intersections:
 *   row 0: PERM MODEL CMD UP VOICE
 *   row 1: STOP (empty) LEFT DOWN RIGHT
 *   row 2: ENTER (C0)  SPACE (C2)
 *
 * ENTER and SPACE are multiple switches wired in parallel to one
 * intersection. There is no approval lever; R1/C1 is unused.
 *
 * Rows use D0/D1/D2 (pulled down). Columns use D6-D10 (active high).
 * The XIAO's USB-C + RESET button share one edge; keep both accessible.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &claudepad_layout;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <3>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)
            RC(1,0) RC(1,2) RC(1,3) RC(1,4)
            RC(2,0) RC(2,2)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;

        diode-direction = "col2row";
        row-gpios
            = <&xiao_d 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
        col-gpios
            = <&xiao_d 6 GPIO_ACTIVE_HIGH>
            , <&xiao_d 7 GPIO_ACTIVE_HIGH>
            , <&xiao_d 8 GPIO_ACTIVE_HIGH>
            , <&xiao_d 9 GPIO_ACTIVE_HIGH>
            , <&xiao_d 10 GPIO_ACTIVE_HIGH>
            ;
    };

    /*
     * Physical order follows the keymap order:
     * PERM MODEL CMD UP VOICE STOP LEFT DOWN RIGHT ENTER SPACE
     *
     * Horizontal pitch 18 mm and vertical pitch 17 mm are represented as
     * 100 x 94 units. R1/C1 is an unused spacer position.
     */
    claudepad_layout: claudepad_layout {
        compatible = "zmk,physical-layout";
        display-name = "ClaudePad";

        keys
            = <&key_physical_attrs 100 94   0   0 0 0 0>
            , <&key_physical_attrs 100 94 100   0 0 0 0>
            , <&key_physical_attrs 100 94 200   0 0 0 0>
            , <&key_physical_attrs 100 94 300   0 0 0 0>
            , <&key_physical_attrs 100 94 400   0 0 0 0>
            , <&key_physical_attrs 100 94   0  94 0 0 0>
            , <&key_physical_attrs 100 94 200  94 0 0 0>
            , <&key_physical_attrs 100 94 300  94 0 0 0>
            , <&key_physical_attrs 100 94 400  94 0 0 0>
            , <&key_physical_attrs 200 94   0 188 0 0 0>
            , <&key_physical_attrs 300 94 200 188 0 0 0>
            ;
    };
};

&claudepad_layout {
    transform = <&default_transform>;
};
